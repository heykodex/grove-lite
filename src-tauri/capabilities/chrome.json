{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "chrome",
  "description": "The tab strip and address bar",
  "webviews": ["chrome"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-start-dragging",
    "core:window:allow-toggle-maximize",
    "allow-get-state",
    "allow-chrome-ready",
    "allow-navigate",
    "allow-new-tab",
    "allow-close-tab",
    "allow-switch-tab",
    "allow-focus-page",
    "allow-window-action",
    "allow-shortcut"
  ]
}
